  "cdn": "https://d8j0ntlcm91z4.cloudfront.net/user_3KjaH969vHSUFPx1mx79dxcwQkP/",
  "clips": {
    "remember": {
      "text": "Remember converting a file?",
      "id": "hf_20261028_133626_350c5f05-f5d3-460f-b072-3ab29977d5d6"
    },
    "pain_short_a": {
      "text": "Every site wants you to upload it, or sign up first.",
      "id": "hf_20261028_133628_f167916a-2564-4a95-a1d1-97ca70d51d3d"
    },
    "pain_upload": {
      "text": "Every site wants you to upload it.",
      "id": "hf_20261028_133627_39e5162e-dee3-4f7d-a030-63c10aa08e1f"
    },
    "pain_signup": {
      "text": "Or sign up first.",
      "id": "hf_20261028_133626_f2a30da0-b3d7-4217-b832-fd52294b4458"
    },
    "pain_handover": {
      "text": "Just to hand over your files.",
      "id": "hf_20261028_133637_2ddf4d7b-1cb4-4d97-a202-abf9ec8018e2"
    },
    "pivot": {
      "text": "There has to be an easier way.",
      "id": "hf_20261028_133637_9412d6bb-4349-4809-b18d-7b51973bd44e"
    },
    "forma": {
      "text": "Here's Forma. It converts your files right on your device.",
      "id": "hf_20261028_133637_261e3655-8367-4760-b6ae-1a2140059119"
    },
    "drop": {
      "text": "Just drop in an image, a video, anything.",
      "id": "hf_20261028_133637_2fe5dad8-3d7a-45fb-abbb-0119a3c19e44"
    },
    "formats": {
      "text": "Fifty-three formats to pick from.",
      "id": "hf_20261028_133644_685fa450-5a9f-4516-b54d-55605c9866da"
    },
    "click": {
      "text": "One click, and it's done.",
      "id": "hf_20261028_133644_542ec60c-f537-4f46-be4f-4abd14e250e1"
    },
    "smaller": {
      "text": "That's ninety-seven percent smaller.",
      "id": "hf_20261028_133644_c3d92e6a-4656-4f73-b1b4-9fe6c6c86e1e"
    },
    "private": {
      "text": "No more uploads. Everything stays on your device.",
      "id": "hf_20261028_133644_7ac82330-1213-4566-9790-23b464a270f6"
    },
    "controls": {
      "text": "Want it resized? Compressed? You get more control, when you need it.",
      "id": "hf_20261028_133652_adf63f6a-30c2-4d8c-af33-9583c36c21ee"
    },
    "free": {
      "text": "And it's free. No account needed.",
      "id": "hf_20261028_133651_a958b703-e3f0-488f-940a-ebceed5c9899"
    },
    "cta": {
      "text": "So next time, skip the upload. Open Forma.",
      "id": "hf_20261028_133651_168f84e8-3e4a-414c-afef-df0cbc277190"
    },
    "end": {
      "text": "Forma. Convert files on your own device.",
      "id": "hf_20261028_133652_21acf5f2-900e-46b9-bffc-38b0426aaaa2"
    }
  },
