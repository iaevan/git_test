{
  "engine": "Higgsfield \u00b7 Eleven v4 (elevenlabs_v4), stability 0.5",
  "voices": {
    "ainsley": {
      "voice_id": "731b4ffe-e95e-59f4-8c00-81608936091f",
      "gender": "female"
    }
  },
  "lines": [
    {
      "i": 0,
      "t": 0.2,
      "end": 2.25,
      "text": "Remember converting a file?",
      "ainsley": "hf_20261028_112950_733017c4-5f58-4b56-bba8-1e6a2de2b345"
    },
    {
      "i": 1,
      "t": 2.35,
      "end": 6.15,
      "text": "Upload it. Sign up. Just to hand over your files.",
      "ainsley": "hf_20261028_112950_d6ae6cc4-d830-430c-8406-e048c37b21d3"
    },
    {
      "i": 2,
      "t": 6.3,
      "end": 10.2,
      "text": "Here's Forma. It converts your files right on your device.",
      "ainsley": "hf_20261028_112959_c32e6918-c7a5-4f44-8e7b-abc10f21cb3f"
    },
    {
      "i": 3,
      "t": 10.4,
      "end": 13.9,
      "text": "Just drop in an image, a video, anything.",
      "ainsley": "hf_20261028_112950_8d949594-d9ba-49b2-80b8-b285a45357ac"
    },
    {
      "i": 4,
      "t": 14.1,
      "end": 17.6,
      "text": "Fifty-three formats to pick from.",
      "ainsley": "hf_20261028_112959_7cd3d39d-ef40-4633-9d56-434d589251be"
    },
    {
      "i": 5,
      "t": 18.45,
      "end": 20.9,
      "text": "One click, and it's done.",
      "ainsley": "hf_20261028_112950_c58c18fa-4c9d-4f3f-b9be-54247a6c18cc"
    },
    {
      "i": 6,
      "t": 21.1,
      "end": 23.7,
      "text": "That's ninety-seven percent smaller.",
      "ainsley": "hf_20261028_113101_06381df0-2205-4992-9d98-a9d80e08d0fc"
    },
    {
      "i": 7,
      "t": 25.3,
      "end": 29.5,
      "text": "No more uploads. Everything stays on your device.",
      "ainsley": "hf_20261028_112959_3bb32108-38b6-4fe7-ac09-fa25452faf29"
    },
    {
      "i": 8,
      "t": 34.0,
      "end": 38.3,
      "text": "Want it resized? Compressed? You get more control, when you need it.",
      "ainsley": "hf_20261028_113006_b23b745b-4089-4764-814d-f55bbb11d554"
    },
    {
      "i": 9,
      "t": 38.5,
      "end": 40.9,
      "text": "And it's free. No account needed.",
      "ainsley": "hf_20261028_113006_4f48932b-71cf-4dfd-96c0-22f8183aab13"
    },
    {
      "i": 10,
      "t": 41.5,
      "end": 45.2,
      "text": "So next time, skip the upload. Open Forma.",
      "ainsley": "hf_20261028_113006_ecae8a2f-0500-4223-842e-2837f3a05e56"
    },
    {
      "i": 11,
      "t": 46.7,
      "end": 51.5,
      "text": "Forma. Convert files on your own device.",
      "ainsley": "hf_20261028_113007_4cd09b2e-411a-4272-88de-2f850792d5d9"
    }
  ],
  "cdn": "https://d8j0ntlcm91z4.cloudfront.net/user_3KjaH969vHSUFPx1mx79dxcwQkP/"
}
