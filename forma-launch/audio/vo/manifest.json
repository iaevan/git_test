  },
  "cdn": "https://d8j0ntlcm91z4.cloudfront.net/user_3KjaH969vHSUFPx1mx79dxcwQkP/",
  "clips": {
    "remember": {
      "text": "Remember converting a file?",
      "id": "hf_20261028_124840_a6a58962-d394-4b57-9dee-b2f8a155a99b"
    },
    "pain_short_a": {
      "text": "Every site wants you to upload it, or sign up first.",
      "id": "hf_20261028_124840_cfc99eb0-dcdd-49af-9cfe-649b19392ff5"
    },
    "pain_short_b": {
      "text": "Every site wants an upload, or a sign-up.",
      "id": "hf_20261028_124840_450ae02d-df34-4102-a61d-4182ae989702"
    },
    "pain_upload": {
      "text": "Every site wants you to upload it.",
      "id": "hf_20261028_124840_26b7da93-e0f5-433f-b5c5-b56b85b0f7d6"
    },
    "pain_signup": {
      "text": "Or sign up first.",
      "id": "hf_20261028_124848_121486c7-f8b3-401d-b293-fe294bf7efca"
    },
    "pain_handover": {
      "text": "Just to hand over your files.",
      "id": "hf_20261028_124847_06ec1723-e1e5-4bb3-8f58-35ea3bc54873"
    },
    "pivot": {
      "text": "There has to be an easier way.",
      "id": "hf_20261028_124846_5b9f47b3-9f02-4c0f-8d2e-cd96535b7cf4"
    },
    "forma": {
      "text": "Here's Forma. It converts your files right on your device.",
      "id": "hf_20261028_124848_f70b8426-f3c4-43f9-aead-a8372ff15350"
    },
    "drop": {
      "text": "Just drop in an image, a video, anything.",
      "id": "hf_20261028_124855_fe10f4e3-860d-4bef-b578-78e9bd00d326"
    },
    "formats": {
      "text": "Fifty-three formats to pick from.",
      "id": "hf_20261028_124856_046d3bc4-5694-4cb9-8aef-7ead4924f47b"
    },
    "click": {
      "text": "One click, and it's done.",
      "id": "hf_20261028_124855_dc872e76-8cf4-488b-819f-08e9ab78798b"
    },
    "smaller": {
      "text": "That's ninety-seven percent smaller.",
      "id": "hf_20261028_124855_cf7eaf66-b700-47f9-8e7e-bece0c276f2e"
    },
    "private": {
      "text": "No more uploads. Everything stays on your device.",
      "id": "hf_20261028_124902_fa0ba7a2-cdfd-4888-b234-82d1fd748306"
    },
    "controls": {
      "text": "Want it resized? Compressed? You get more control, when you need it.",
      "id": "hf_20261028_124902_723c3cc2-2816-49ae-b341-3290c74a1bbb"
    },
    "free": {
      "text": "And it's free. No account needed.",
      "id": "hf_20261028_124902_c7e249fe-3233-411a-acd4-25039f59afd3"
    },
    "cta": {
      "text": "So next time, skip the upload. Open Forma.",
      "id": "hf_20261028_124902_76209504-4eba-40db-8bf6-2f8c9fbc259f"
    },
    "end": {
      "text": "Forma. Convert files on your own device.",
      "id": "hf_20261028_124908_876b63f4-02e1-445b-b66f-aea0af20ebf8"
    }
  },
