 "lines": [
  {
   "say": "Growing a business shouldn't mean more work.",
   "scene": "s1",
   "move": "still",
   "hold": 1.6
  },
  {
   "say": "Leads need follow-ups. Customers ask the same questions. Content has to reach every channel.",
   "scene": "s2",
   "move": "still"
  },
  {
   "say": "AI Revenue turns inquiries into sales conversations. It captures the lead, prepares the follow-up, and keeps your sales tools in sync.",
   "scene": "s3",
   "move": "still"
  },
  {
   "say": "AI Operations builds assistants that answer from your approved documents, handle routine tasks, and connect your tools. Your team reviews what matters.",
   "scene": "s4",
   "move": "still"
  },
  {
   "say": "Got an idea? We design, build and launch SaaS products, websites and web apps, starting with the features your customers and team need most.",
   "scene": "s5",
   "move": "still"
  },
  {
   "say": "AI Content Workflow turns one brief into content for every channel. Your team approves what goes out.",
   "scene": "s6",
   "move": "still"
  },
  {
   "say": "In every system, your team has the final say.",
   "scene": "s7",
   "move": "still",
   "hold": 0.9
  },
  {
   "say": "We start simple. Understand the problem. Plan the first version. Build and launch it. Then keep improving.",
   "scene": "s8",
   "move": "still"
  },
  {
   "say": "Have a project in mind? Book an AI audit, and we'll help you find a clear first step. Zavino. Where vision takes flight.",
   "scene": "s9",
   "move": "still"
  }
 ],
