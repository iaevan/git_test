   "scene": [
    "visit-stamps",
    "regular-badge"
   ],
   "move": "still"
  },
  {
   "say": "And one morning… The usual, Rafi? Oh! You remembered!",
   "caption": "And one morning… / The usual, Rafi? / Oh! You remembered!",
   "scene": [
    "morning-door",
    "usual",
    "remembered"
   ],
   "move": "push",
