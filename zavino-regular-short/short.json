 "lines": [
  {
   "say": "When Nila opened Café 27, she knew everyone. Every name. Every order.",
   "caption": "When Nila opened Café 27, / she knew everyone. / Every name. Every order.",
   "scene": [
    "open-sign",
    "early-names",
    "early-orders"
   ],
   "move": "push"
  },
  {
   "say": "Then it got busy. And somewhere in the rush, she stopped knowing them.",
   "caption": "Then it got busy. / And somewhere in the rush, / she stopped knowing them.",
   "scene": [
    "crowd-count",
    "lineup",
    "nila-blank"
   ],
   "move": "push"
  },
  {
   "say": "So when a coffee came out cold, nobody noticed. No complaint. They just left.",
   "caption": "So when a coffee came out cold, / nobody noticed. / No complaint. They just left.",
   "scene": [
    "unhappy-sip",
    "quiet-exit",
    "door-close"
   ],
   "move": "push"
  },
  {
   "say": "A week later, one star told her what nobody had.",
   "caption": "A week later, / one star told her / what nobody had.",
   "scene": "one-star",
   "move": "still"
  },
  {
   "say": "Growing shouldn't mean forgetting.",
   "caption": "Growing shouldn't mean forgetting.",
   "scene": "nila-closing",
   "move": "push",
   "pause": 0.9
  },
  {
   "say": "So at Zavino Labs, we're building a way for cafés to remember.",
   "caption": "So at Zavino Labs, / we're building a way / for cafés to remember.",
   "scene": [
    "labs-brand",
    "labs-build"
   ],
   "move": "still",
   "pause": 0.5
  },
  {
   "say": "A QR on every table. Rafi scans, checks in, picks his order.",
   "caption": "A QR on every table. / Rafi scans, / checks in, / picks his order.",
   "scene": [
    "table-qr",
    "rafi-scan",
    "otp",
    "menu-pick"
   ],
   "move": "still",
   "pause": 0.8
  },
  {
   "say": "One code. One bill. And Rafi isn't a stranger anymore.",
   "caption": "One code. / One bill. / And Rafi isn't a stranger anymore.",
   "scene": [
    "code-show",
    "bill-entry",
    "verified"
   ],
   "move": "push"
  },
  {
   "say": "An hour later, how was it?",
   "caption": "An hour later: / how was it?",
   "scene": [
    "hour-later",
    "chat-ask"
   ],
   "move": "still",
   "pause": 0.8
  },
  {
   "say": "Happy? Tell Google. Not happy? Nila hears about it first, in time to make it right.",
   "caption": "Happy? Tell Google. / Not happy? Nila hears about it first — / in time to make it right.",
   "scene": [
    "five-star",
    "low-alert",
    "make-it-right"
   ],
   "move": "still",
   "pause": 0.3
  },
  {
   "say": "Visit by visit, Rafi becomes a regular.",
